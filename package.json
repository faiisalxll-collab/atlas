{
  "name": "atlas-universe",
  "private": true,
  "version": "1.0.0",
  "description": "ATLAS — The Open Source Universe: Interactive 3D Knowledge Explorer for Curated GitHub Repositories",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "sync:sample": "python3 scripts/sync.py --use-local-fallback"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "graphology": "^0.25.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
